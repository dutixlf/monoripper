{
  "name": "monoripper",
  "version": "0.1.0-dev.0",
  "description": "Run selected Elysia application contexts in isolated Bun processes.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": ">=1.3.13"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "monoripper": "./dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && bun build src/index.ts src/cli.ts src/worker.ts --target bun --external elysia --external @grpc/grpc-js --external @grpc/proto-loader --splitting --outdir dist --entry-naming '[name].js' --chunk-naming 'chunk-[hash].js' && cp src/control.proto dist/control.proto && tsc -p tsconfig.build.json",
    "check:specs": "python3 scripts/check-specs.py",
    "test:private-backend": "bun scripts/test-private-backend.ts",
    "test:private-backend:postgres": "bun scripts/test-private-backend-postgres.ts",
    "test:package": "bun scripts/test-package.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "elysia": "1.4.30",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "embedded-postgres": "18.4.0-beta.17"
  },
  "trustedDependencies": [
    "@embedded-postgres/linux-x64"
  ]
}
